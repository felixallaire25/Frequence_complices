---
/**
 * Ligne de défilement : remplace la barre de défilement du navigateur
 * (ordinateurs uniquement) par une fine ligne qui ondule comme une corde
 * quand on fait défiler la page.
 * Grâce au mode de fusion « difference », elle apparaît claire sur les fonds
 * noirs et sombre sur les fonds beiges.
 * On peut la saisir (ou cliquer dessus) pour se déplacer dans la page.
 * Le clavier, la molette et le pavé tactile continuent de fonctionner
 * normalement.
 */
---

<div class="scroll-line" aria-hidden="true" hidden>
  <svg>
    <defs>
      <clipPath id="scroll-line-clip"><rect x="0" y="0" width="40" height="0"></rect></clipPath>
    </defs>
    <path class="track"></path>
    <path class="progress" clip-path="url(#scroll-line-clip)"></path>
    <circle class="knob" r="3.5" cx="12" cy="0"></circle>
  </svg>
</div>

<style is:global>
  html.has-scroll-line {
    scrollbar-width: none;
  }
  html.has-scroll-line::-webkit-scrollbar {
    display: none;
  }
</style>

<style>
  .scroll-line {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    width: 24px;
    mix-blend-mode: difference;
    cursor: grab;
    touch-action: none;
  }
  .scroll-line:active {
    cursor: grabbing;
  }
  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  path {
    fill: none;
    stroke: #ebe6d8;
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .track {
    opacity: 0.3;
  }
  .knob {
    fill: #ebe6d8;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.scroll-line');
  const fine = window.matchMedia('(pointer: fine)').matches;

  if (root && fine) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const track = root.querySelector<SVGPathElement>('.track')!;
    const progress = root.querySelector<SVGPathElement>('.progress')!;
    const clip = root.querySelector<SVGRectElement>('clipPath rect')!;
    const knob = root.querySelector<SVGCircleElement>('.knob')!;
    const CX = 12; // position horizontale de la ligne dans la zone de 24 px

    document.documentElement.classList.add('has-scroll-line');
    root.hidden = false;

    let H = window.innerHeight;
    let max = 1;
    let lastY = window.scrollY;
    let energy = 0; // amplitude de la vibration, en pixels
    let phase = 0;
    let raf = 0;
    let lastT = 0;

    function measure() {
      H = window.innerHeight;
      max = Math.max(1, document.documentElement.scrollHeight - H);
      root!.hidden = document.documentElement.scrollHeight <= H + 2;
    }

    // Corde fixée en haut et en bas : un léger ondoiement permanent
    // + une vibration qui s'éteint après le défilement.
    function shape(): string {
      const step = 6;
      let d = '';
      for (let y = 0; y <= H; y += step) {
        const s = y / H;
        const ends = Math.sin(Math.PI * s); // 0 aux extrémités
        const rest = 1.6 * Math.sin(y * 0.035 + phase * 0.35) * ends;
        const vib =
          energy *
          ends *
          (Math.sin(Math.PI * 3 * s) * Math.sin(phase * 7) * 0.65 +
            Math.sin(Math.PI * 7 * s + 1.3) * Math.sin(phase * 13) * 0.35);
        d += `${y === 0 ? 'M' : 'L'}${(CX + rest + vib).toFixed(2)} ${y}`;
      }
      return d;
    }

    function draw() {
      const p = Math.min(1, Math.max(0, window.scrollY / max));
      const d = shape();
      track.setAttribute('d', d);
      progress.setAttribute('d', d);
      clip.setAttribute('height', String(p * H));
      knob.setAttribute('cy', String(Math.min(H - 4, Math.max(4, p * H))));
    }

    function tick(t: number) {
      const dt = lastT ? Math.min((t - lastT) / 1000, 0.05) : 0.016;
      lastT = t;
      phase += dt;
      energy *= Math.exp(-dt * 2.4);
      draw();
      if (energy > 0.05) raf = requestAnimationFrame(tick);
      else {
        energy = 0;
        raf = 0;
        lastT = 0;
        draw();
      }
    }

    function kick() {
      if (!raf && !reduce) raf = requestAnimationFrame(tick);
      else if (reduce) draw();
    }

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        if (!reduce) energy = Math.min(9, energy + Math.abs(y - lastY) * 0.05);
        lastY = y;
        if (reduce || !raf) draw();
        kick();
      },
      { passive: true },
    );

    // Saisir la ligne pour se déplacer dans la page
    let dragging = false;
    const go = (clientY: number) => {
      window.scrollTo({ top: (clientY / H) * max, behavior: 'instant' as ScrollBehavior });
    };
    root.addEventListener('pointerdown', (e) => {
      dragging = true;
      root.setPointerCapture(e.pointerId);
      go(e.clientY);
      e.preventDefault();
    });
    root.addEventListener('pointermove', (e) => dragging && go(e.clientY));
    root.addEventListener('pointerup', () => (dragging = false));
    root.addEventListener('pointercancel', () => (dragging = false));

    new ResizeObserver(() => {
      measure();
      draw();
    }).observe(document.body);
    measure();
    draw();
  }
</script>
