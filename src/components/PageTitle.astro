---
/** Bandeau noir des pages intérieures : bande d'ondes + grand titre. */
import WaveBand from './WaveBand.astro';

interface Props {
  title: string;
  seed?: number;
}
const { title, seed = 1 } = Astro.props;
---

<WaveBand seed={seed} height={170} />
<div class="wrap title">
  <h1 class="h1-page">{title}</h1>
</div>

<style>
  .title {
    padding-block: 8px 48px;
  }
</style>
