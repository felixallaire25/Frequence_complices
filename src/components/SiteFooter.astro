---
import { site } from '../data/site';
---

<footer class="site-footer dark wrap">
  <div class="grid">
    <div>
      <p class="name">Fréquences<br />Complices</p>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <nav aria-label="Informations légales">
      <a class="fl" href="/mentions-legales/">Mentions légales</a>
      <a class="fl" href="/confidentialite/">Politique de confidentialité</a>
      <a class="fl" href="/cookies/">Cookies</a>
    </nav>
    <p class="credit">Site réalisé par {site.realisation}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 64px 40px;
    /* séparation discrète, utile quand le corps de page est aussi sombre */
    border-top: 1px solid color-mix(in srgb, var(--sur-sombre) 14%, transparent);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 40px;
  }
  .name {
    margin: 0 0 16px;
    font-family: var(--f-titre);
    font-weight: 600;
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .mail {
    font-size: 18px;
    overflow-wrap: anywhere;
  }
  nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .credit {
    margin: 0;
    font-size: 18px;
    color: var(--sur-sombre-2);
  }
</style>
