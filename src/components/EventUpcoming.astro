---
import { dateCourte, dernierJour, type Evenement } from '../lib/evenements';

interface Props {
  e: Evenement;
}
const { e } = Astro.props;
const { titre, heure, lieu, inscription } = e.data;
const infos = [lieu, heure].filter(Boolean).join(', ');
const lienValide = inscription && /^(https?:|mailto:)/.test(inscription);
---

<li class="ev" data-fin={dernierJour(e)}>
  <p class="date"><time datetime={e.data.date.toISOString().slice(0, 10)}>{dateCourte(e)}</time></p>
  <div class="txt">
    <h3><a href={`/evenements/${e.id}/`}>{titre}</a></h3>
    {infos && <p class="infos">{infos}</p>}
  </div>
  {
    lienValide && (
      <a class="btn" href={inscription} target="_blank" rel="noopener">
        S’inscrire<span class="visually-hidden"> à « {titre} » (nouvel onglet)</span>
      </a>
    )
  }
</li>

<style>
  .ev {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 48px;
    padding: 28px;
    border: 1.5px solid var(--noir);
  }
  .date {
    margin: 0;
    font-family: var(--f-date);
    font-weight: 600;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1;
    white-space: nowrap;
  }
  .txt {
    flex: 1 1 260px;
  }
  h3 {
    margin: 0 0 6px;
    font-family: var(--f-titre);
    font-weight: 600;
    font-size: clamp(28px, 3vw, 36px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .infos {
    margin: 0;
    font-size: 18px;
    color: var(--gris-sur-beige);
  }
</style>
