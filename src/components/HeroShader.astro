---
/**
 * Fond animé de l'accueil.
 * Une image fixe s'affiche d'abord (et reste seule si l'animation n'est
 * pas souhaitable : mouvement réduit, économie de données, appareil
 * modeste, WebGL indisponible). Sinon, l'animation WebGL la remplace
 * en fondu dès qu'elle est prête. Le code WebGL n'est téléchargé que
 * lorsqu'il est utilisé.
 */
import { getImage } from 'astro:assets';
import posterDesktop from '../assets/hero/hero-desktop.jpg';
import posterMobile from '../assets/hero/hero-mobile.jpg';

const desktop = await getImage({ src: posterDesktop, format: 'webp', width: 1600, quality: 78 });
const mobile = await getImage({ src: posterMobile, format: 'webp', width: 780, quality: 78 });
---

<div class="hero-bg" aria-hidden="true">
  <picture>
    <source media="(max-width: 699px)" srcset={mobile.src} />
    <img src={desktop.src} alt="" fetchpriority="high" decoding="async" />
  </picture>
  <canvas></canvas>
  <div class="veil"></div>
</div>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--noir);
  }
  img,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  canvas {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero-bg:global(.is-live) canvas {
    opacity: 1;
  }
  /* Fondus en haut (navigation) et en bas (titre) pour la lisibilité */
  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      #060606 0,
      rgba(6, 6, 6, 0) 20%,
      rgba(6, 6, 6, 0) 52%,
      rgba(6, 6, 6, 0.85) 82%,
      #060606 100%
    );
    pointer-events: none;
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>('.hero-bg');
  const canvas = box?.querySelector('canvas');

  function animationSouhaitee() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
    const nav = navigator as Navigator & {
      connection?: { saveData?: boolean };
      deviceMemory?: number;
    };
    if (nav.connection?.saveData) return false;
    if (nav.deviceMemory !== undefined && nav.deviceMemory < 2) return false;
    if (nav.hardwareConcurrency !== undefined && nav.hardwareConcurrency < 3) return false;
    try {
      const test = document.createElement('canvas');
      if (!(test.getContext('webgl2') || test.getContext('webgl'))) return false;
    } catch {
      return false;
    }
    return true;
  }

  if (box && canvas && animationSouhaitee()) {
    import('../scripts/hero-shader').then(({ startHero }) => {
      try {
        startHero({
          container: box,
          canvas,
          pointerTarget: box.parentElement ?? box,
          onReady: () => box.classList.add('is-live'),
          onTooSlow: () => box.classList.remove('is-live'),
        });
      } catch (err) {
        console.warn('Animation désactivée :', err);
      }
    });
  }
</script>
