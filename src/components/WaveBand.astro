---
/**
 * Bande d'ondes décorative (en-têtes des pages intérieures, cartes Productions).
 *
 * Les tracés sont calculés au moment de la construction du site (aucun
 * JavaScript lourd côté visiteur) : des lignes empilées, remplies de noir,
 * qui se masquent les unes les autres comme un relief vu de face.
 * L'animation est en CSS, coupée si l'utilisateur préfère réduire les
 * animations, et mise en pause quand la bande sort de l'écran.
 */
interface Props {
  /** Graine : change la forme des ondes (même graine = même dessin). */
  seed?: number;
  /** Hauteur affichée, en pixels. */
  height?: number;
  /** Nombre de lignes. */
  lines?: number;
  class?: string;
}

const { seed = 1, height = 170, lines = 9, class: className } = Astro.props;

const W = 1440; // largeur de référence
const PERIOD = 720; // motif répété (permet une boucle sans couture)
const STEP = 24;
const COLORS = ['#FF5C8A', '#FFB347', '#4FE3D2', '#8A94FF'];

// Générateur pseudo-aléatoire déterministe (mulberry32)
function rng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed * 9973 + lines * 31 + height);

const uid = `wb${seed}-${height}-${lines}`;
const bottom = height + 40;

const paths = Array.from({ length: lines }, (_, i) => {
  const t = lines === 1 ? 1 : i / (lines - 1); // 0 = au fond, 1 = devant
  const base = height * (0.13 + 0.77 * Math.pow(t, 1.15));
  const amp = height * (0.012 + 0.07 * t * t + 0.02 * t);
  // Somme d'harmoniques périodiques sur PERIOD → courbe organique qui boucle
  const harmonics = Array.from({ length: 5 }, (_, k) => ({
    f: k + 1 + Math.floor(rand() * 2),
    a: (rand() * 0.8 + 0.2) / (k + 1),
    p: rand() * Math.PI * 2,
  }));
  const norm = harmonics.reduce((s, h) => s + h.a, 0);
  const pts: string[] = [];
  for (let x = -PERIOD; x <= W + PERIOD; x += STEP) {
    const ph = (x / PERIOD) * Math.PI * 2;
    const y = base + (amp * harmonics.reduce((s, h) => s + h.a * Math.sin(h.f * ph + h.p), 0)) / norm;
    pts.push(`${x} ${y.toFixed(1)}`);
  }
  const d = `M${pts.join('L')}L${W + PERIOD} ${bottom}L${-PERIOD} ${bottom}Z`;
  return {
    d,
    gradient: `${uid}-g${i % 4}-${i % 2}`,
    width: (0.9 + 1.9 * t).toFixed(2),
    opacity: (0.4 + 0.6 * t).toFixed(2),
    duration: (46 - 30 * t).toFixed(1),
    delay: (-rand() * 40).toFixed(1),
    reverse: i % 3 === 1,
  };
});

// Dégradés : 4 rotations de palette × 2 longueurs de répétition
const gradients = [0, 1, 2, 3].flatMap((rot) =>
  [0, 1].map((alt) => ({
    id: `${uid}-g${rot}-${alt}`,
    span: alt ? 360 : 720,
    stops: [0, 1, 2, 3, 4].map((s) => COLORS[(s + rot) % 4]),
  })),
);
---

<div class:list={['wave-band', className]} style={`height:${height}px`} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${height}`} preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      {
        gradients.map((g) => (
          <linearGradient
            id={g.id}
            gradientUnits="userSpaceOnUse"
            x1="0"
            y1="0"
            x2={g.span}
            y2="0"
            spreadMethod="repeat"
          >
            {g.stops.map((c, s) => (
              <stop offset={s / 4} stop-color={c} />
            ))}
          </linearGradient>
        ))
      }
    </defs>
    {
      paths.map((p) => (
        <path
          class:list={['wv', { wr: p.reverse }]}
          d={p.d}
          fill="#060606"
          stroke={`url(#${p.gradient})`}
          stroke-width={p.width}
          stroke-opacity={p.opacity}
          stroke-linejoin="round"
          style={`animation-duration:${p.duration}s;animation-delay:${p.delay}s`}
        />
      ))
    }
  </svg>
</div>

<style>
  .wave-band {
    position: relative;
    overflow: hidden;
  }
  svg {
    width: 100%;
    height: 100%;
  }
  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-720px);
    }
  }
  .wv {
    animation: drift linear infinite;
  }
  .wr {
    animation-direction: reverse;
  }
  .wave-band:global(.is-paused) .wv {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .wv {
      animation: none;
    }
  }
</style>

<script>
  // Met en pause les ondes qui ne sont pas à l'écran (économise la batterie).
  const bands = document.querySelectorAll<HTMLElement>('.wave-band');
  if ('IntersectionObserver' in window && bands.length) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.target.classList.toggle('is-paused', !e.isIntersecting);
    });
    bands.forEach((b) => io.observe(b));
  }
</script>
