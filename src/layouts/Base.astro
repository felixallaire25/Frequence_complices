---
/**
 * Gabarit commun à toutes les pages :
 * <head>, bandeau noir (en-tête + titre de page), contenu, pied de page.
 */
import '@fontsource-variable/familjen-grotesk/wght.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/instrument-sans/wght-italic.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '../styles/global.css';

import titreFont from '@fontsource-variable/familjen-grotesk/files/familjen-grotesk-latin-wght-normal.woff2?url';
import texteFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site, type NavKey } from '../data/site';

interface Props {
  /** Titre de la page (affiché dans l'onglet). Laisser vide pour l'accueil. */
  title?: string;
  description?: string;
  current?: NavKey;
  /** Empêche l'indexation (pages en attente de contenu, par ex.). */
  noindex?: boolean;
}

const { title, description = site.description, current, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.nom}` : site.nom;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060606" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="preload" href={titreFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={texteFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <div class="page">
      <!-- Fond noir (ou animation) derrière l'en-tête et le titre de page -->
      <div class="masthead-bg">
        <slot name="backdrop" />
      </div>
      <SiteHeader current={current} />
      <main>
        <div class="masthead-content dark" id="contenu" tabindex="-1">
          <slot name="masthead" />
        </div>
        <div class="page-body">
          <slot />
        </div>
      </main>
    </div>

    <SiteFooter />
  </body>
</html>

<style>
  /*
   * L'en-tête (<header>) et le titre de page (dans <main>) partagent le
   * même fond noir : une grille place le fond derrière les deux.
   */
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto auto;
  }
  .masthead-bg {
    grid-row: 1 / 3;
    grid-column: 1;
    position: relative;
    overflow: hidden;
    background: var(--noir);
  }
  .page > :global(.site-header) {
    grid-row: 1;
    grid-column: 1;
  }
  main {
    grid-row: 2 / 4;
    grid-column: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: subgrid;
  }
  .masthead-content {
    position: relative;
    z-index: 1;
    background: transparent;
  }
  .masthead-content:focus {
    outline: none;
  }
  /* Navigateurs anciens sans subgrid : fond noir simple, sans animation */
  @supports not (grid-template-rows: subgrid) {
    main {
      display: block;
    }
    .masthead-bg {
      grid-row: 1;
    }
    .masthead-content {
      background: var(--noir);
    }
  }
</style>
