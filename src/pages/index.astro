---
import Base from '../layouts/Base.astro';
import HeroShader from '../components/HeroShader.astro';
---

<Base current="accueil">
  <HeroShader slot="backdrop" />

  <div slot="masthead" class="hero">
    <div class="hero-spacer" aria-hidden="true"></div>
    <div class="hero-title wrap">
      <h1 data-onde="titre">Fréquences<br />Complices</h1>
      <p class="muted">Un espace complice, accessible et conscient, pour la création et le lien.</p>
    </div>
  </div>

  <section class="wrap sections">
    <nav aria-label="Sections du site">
      <a class="row" href="/a-propos/">
        <span class="rt" data-onde="survol">À propos</span>
        <span class="rm">Notre manifeste</span>
      </a>
      <a class="row" href="/evenements/">
        <span class="rt" data-onde="survol">Événements</span>
        <span class="rm">Dates à venir et éditions passées</span>
      </a>
      <a class="row" href="/productions/">
        <span class="rt" data-onde="survol">Productions</span>
        <span class="rm">Podcast, documentaire, événements</span>
      </a>
    </nav>
  </section>
</Base>

<style>
  /* Le bandeau d'accueil occupe exactement la hauteur de l'écran */
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
  }
  .hero-spacer {
    flex: 1 1 auto;
    min-height: 120px;
  }
  .hero-title {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
    padding-block: 24px clamp(32px, 6svh, 56px);
  }
  h1 {
    margin: 0;
    flex: 1 1 auto;
    font-family: var(--f-titre);
    font-weight: 600;
    /* limité aussi par la hauteur d'écran, pour tout voir sans défiler */
    font-size: clamp(56px, min(11.4vw, 17svh), 172px);
    line-height: 0.88;
    letter-spacing: -0.04em;
  }
  .hero-title p {
    margin: 0;
    flex: 0 1 320px;
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.4;
  }

  .sections {
    padding-block: 72px 88px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 32px;
    padding: 28px 16px;
    margin: 0 -16px;
    border-top: var(--trait);
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .row:last-child {
    border-bottom: var(--trait);
  }
  .row:hover {
    background: var(--noir);
    color: var(--beige);
  }
  .row:focus-visible {
    outline-offset: -3px;
  }
  .rt {
    font-family: var(--f-titre);
    font-weight: 600;
    font-size: clamp(40px, 6vw, 88px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .rm {
    font-family: var(--f-date);
    font-size: 17px;
    color: var(--gris-sur-beige);
    transition: color 0.2s;
  }
  .row:hover .rm {
    color: var(--gris-sur-noir);
  }
</style>
